# Copy to .env or export these before `python app.py`. Everything is optional.

# --- basics ---
# YELI_SECRET_KEY=change-me          # session key (generated into instance/secret_key if missing)
# YELI_HTTPS=1                       # set when the site is served over HTTPS
# YELI_ADMINS=yourusername           # who can open the Admin page (cash-outs, sales)
# HOST=127.0.0.1  PORT=5000  YELI_THREADS=32

# --- hosting (Render: see render.yaml) ---
# HOST=0.0.0.0                       # needed inside containers / on Render
# YELI_PROXY=1                       # behind a reverse proxy (Render): trust X-Forwarded-* headers
# YELI_ALLOWED_HOSTS=yeli.onrender.com   # optional: reject other Host headers (Flask 3.1+)
# YELI_DEMO=1                        # show the "data may be reset" banner (ephemeral hosting)

# --- media server (many viewers, many streamers). Leave empty for peer-to-peer ---
# YELI_MEDIA_URL=http://localhost:8889

# --- Yelis economy ---
# YELI_PAYMENTS=sandbox              # sandbox = play money. See README before changing it
# YELI_CURRENCY=USD
# YELI_TAX_RATE=0.21                 # tax already included in the price buyers pay (0 = none)
# YELI_PROCESSOR_PCT=0.039           # estimated payment fee (accounting only)
# YELI_PROCESSOR_FIXED_CENTS=30
# YELI_EARN_RATES=[50,56,62,68,74,80]   # cents per 100 earned Yelis at each Earnings level (6 values)
# YELI_POINT_COST=100                # Yelis per upgrade point
# YELI_PAYOUT_MIN_COINS=5000
# YELI_PAYOUT_HOLD_DAYS=14
# YELI_PAYOUT_WITHHOLD_PCT=0         # tax withholding on cash-outs, if you must
# YELI_PAYOUT_FEE_CENTS=0

# --- saved streams (videos on the profile) ---
# YELI_VOD_DIR=/var/data/vods        # where the video files go (default: "vods" next to the database)
# YELI_VOD_MAX_MB=1024               # size limit per video
# YELI_VOD_MAX_PER_USER=30           # saved videos per channel
# YELI_VOD_BLOCK_DIRECT=1            # 1 (default): the video file is only served to the player, not to direct open / save-as. 0 = off

# Daily chest: seconds of watching live streams (per UTC day) to unlock it, and the odds of each reward.
# Upgrade points are worth Yelis, so keep that weight low (0 = the chest never gives points).
# YELI_CHEST_SECONDS=3600
# YELI_CHEST_WEIGHTS={"sticker":55,"color":40,"points":5}

# --- notifications by email (the bell inside the app needs nothing) ---
# Pick ONE way to send. On Render's free plan SMTP ports are blocked, so use the HTTPS API (Resend, free tier).
# YELI_PUBLIC_URL=https://yeli.onrender.com     # REQUIRED for email: the address used in the links of the emails
# YELI_MAIL_FROM=Yeli <no-reply@your-domain.com> # sender (with Resend it must be on a domain you verified there)
# YELI_RESEND_API_KEY=re_xxxxxxxx               # option A: Resend (HTTPS API)
# YELI_SMTP_HOST=smtp.example.com               # option B: any SMTP server
# YELI_SMTP_PORT=587  YELI_SMTP_USER=...  YELI_SMTP_PASSWORD=...  YELI_SMTP_SECURITY=starttls   # starttls | ssl | none
# YELI_MAIL_CONSOLE=1                           # development: print the emails in the console instead of sending them
# YELI_NOTIFY_EMAILS_PER_HOUR=12                # cap per person so nobody can flood an inbox

# Send the stream to other platforms (Kick, TikTok, Twitch...): needs ffmpeg and the media server
# YELI_MEDIA_RTSP=rtsp://127.0.0.1:8554
# YELI_FFMPEG=/usr/bin/ffmpeg
